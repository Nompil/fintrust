# Configuration template. Values below are placeholders, not credentials.
# Local setup generates a separate, Git-ignored .env for the practice databases.
AWS_REGION=af-south-1
S3_RAW_BUCKET=fintrust-ingest-dev
S3_REPORT_BUCKET=fintrust-reports
DYNAMODB_TABLE=risk_scores
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fintrust
DB_USER=fintrust_app
DB_PASSWORD=replace-this-for-local-development
CORS_ALLOWED_ORIGINS=

# Local password auth; AWS Lambda must use DB_AUTH_MODE=iam, never this password.
# SSM paths are /fintrust/{FINTRUST_STAGE}/{FINTRUST_SERVICE}/db_host|db_name|db_user.
FINTRUST_STAGE=dev
FINTRUST_SERVICE=api
DB_AUTH_MODE=password
# Deploy the RDS CA bundle and set this path for AWS verify-full connections.
DB_SSLROOTCERT=
# Processing Lambda environment (provisioning remains an explicit operator action).
TRANSACTION_QUEUE_URL=
ALERT_FUNCTION_ARN=
SES_SENDER=
SES_RECIPIENT=
# Provisional teaching thresholds; facilitator confirmation required.
RISK_HIGH_AMOUNT=50000
RISK_VERY_HIGH_AMOUNT=200000
RISK_AMOUNT_POINTS=30
RISK_VERY_HIGH_POINTS=25
RISK_TRANSFER_POINTS=20
RISK_CROSS_BORDER_POINTS=15
RISK_MERCHANT_POINTS=20
RISK_VELOCITY_COUNT=5
RISK_VELOCITY_SECONDS=300
RISK_VELOCITY_POINTS=30
RISK_MEDIUM=40
RISK_HIGH=70
