{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadApiInventoryAndAccount",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET"
      ],
      "Resource": [
        "arn:aws:apigateway:af-south-1::/restapis",
        "arn:aws:apigateway:af-south-1::/account"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        }
      }
    },
    {
      "Sid": "ManageOnlyBoundApi",
      "Effect": "Allow",
      "Action": [
        "apigateway:POST",
        "apigateway:PUT",
        "apigateway:PATCH",
        "apigateway:DELETE"
      ],
      "Resource": [
        "arn:aws:apigateway:af-south-1::/restapis/qzgzopn8o4",
        "arn:aws:apigateway:af-south-1::/restapis/qzgzopn8o4/*",
        "arn:aws:apigateway:af-south-1::/tags/arn%3Aaws%3Aapigateway%3Aaf-south-1%3A%3A%2Frestapis%2Fqzgzopn8o4"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ReadOnlyBoundApi",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET"
      ],
      "Resource": [
        "arn:aws:apigateway:af-south-1::/restapis/qzgzopn8o4",
        "arn:aws:apigateway:af-south-1::/restapis/qzgzopn8o4/*",
        "arn:aws:apigateway:af-south-1::/tags/arn%3Aaws%3Aapigateway%3Aaf-south-1%3A%3A%2Frestapis%2Fqzgzopn8o4"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        }
      }
    }
  ]
}
