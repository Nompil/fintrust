{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageFourFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:DeleteFunction",
        "lambda:PutFunctionConcurrency",
        "lambda:DeleteFunctionConcurrency",
        "lambda:TagResource",
        "lambda:UntagResource"
      ],
      "Resource": [
        "arn:aws:lambda:af-south-1:966467878406:function:fintrust-scoring-dev",
        "arn:aws:lambda:af-south-1:966467878406:function:fintrust-alert-dev",
        "arn:aws:lambda:af-south-1:966467878406:function:fintrust-report-dev",
        "arn:aws:lambda:af-south-1:966467878406:function:fintrust-api-dev"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ReadFourFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetFunctionConcurrency",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:ListTags",
        "lambda:GetPolicy"
      ],
      "Resource": [
        "arn:aws:lambda:af-south-1:966467878406:function:fintrust-scoring-dev",
        "arn:aws:lambda:af-south-1:966467878406:function:fintrust-alert-dev",
        "arn:aws:lambda:af-south-1:966467878406:function:fintrust-report-dev",
        "arn:aws:lambda:af-south-1:966467878406:function:fintrust-api-dev",
        "arn:aws:lambda:af-south-1:966467878406:function:fintrust-api-dev:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        }
      }
    },
    {
      "Sid": "ManageApiVersionsAndAlias",
      "Effect": "Allow",
      "Action": [
        "lambda:PublishVersion",
        "lambda:CreateAlias",
        "lambda:UpdateAlias",
        "lambda:DeleteAlias",
        "lambda:DeleteFunction"
      ],
      "Resource": [
        "arn:aws:lambda:af-south-1:966467878406:function:fintrust-api-dev",
        "arn:aws:lambda:af-south-1:966467878406:function:fintrust-api-dev:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ReadApiVersionsAndAlias",
      "Effect": "Allow",
      "Action": [
        "lambda:GetAlias",
        "lambda:ListAliases",
        "lambda:ListVersionsByFunction"
      ],
      "Resource": [
        "arn:aws:lambda:af-south-1:966467878406:function:fintrust-api-dev",
        "arn:aws:lambda:af-south-1:966467878406:function:fintrust-api-dev:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        }
      }
    },
    {
      "Sid": "ManageReportAsync",
      "Effect": "Allow",
      "Action": [
        "lambda:PutFunctionEventInvokeConfig",
        "lambda:UpdateFunctionEventInvokeConfig",
        "lambda:DeleteFunctionEventInvokeConfig"
      ],
      "Resource": "arn:aws:lambda:af-south-1:966467878406:function:fintrust-report-dev:$LATEST",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ReadReportAsync",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunctionEventInvokeConfig"
      ],
      "Resource": "arn:aws:lambda:af-south-1:966467878406:function:fintrust-report-dev:$LATEST",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        }
      }
    },
    {
      "Sid": "PassOnlyFourRuntimeRoles",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::966467878406:role/fintrust-scoring-dev",
        "arn:aws:iam::966467878406:role/fintrust-alert-dev",
        "arn:aws:iam::966467878406:role/fintrust-report-dev",
        "arn:aws:iam::966467878406:role/fintrust-api-dev"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "iam:PassedToService": "lambda.amazonaws.com"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "GrantScheduleInvoke",
      "Effect": "Allow",
      "Action": [
        "lambda:AddPermission"
      ],
      "Resource": "arn:aws:lambda:af-south-1:966467878406:function:fintrust-report-dev",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "lambda:Principal": "events.amazonaws.com"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "GrantApiGatewayInvoke",
      "Effect": "Allow",
      "Action": [
        "lambda:AddPermission"
      ],
      "Resource": "arn:aws:lambda:af-south-1:966467878406:function:fintrust-api-dev:dev",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "lambda:Principal": "apigateway.amazonaws.com"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "RemoveOwnedInvokeStatements",
      "Effect": "Allow",
      "Action": [
        "lambda:RemovePermission"
      ],
      "Resource": [
        "arn:aws:lambda:af-south-1:966467878406:function:fintrust-report-dev",
        "arn:aws:lambda:af-south-1:966467878406:function:fintrust-api-dev:dev"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ReadNineNonsecretSettings",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameters",
        "ssm:GetParameter"
      ],
      "Resource": [
        "arn:aws:ssm:af-south-1:966467878406:parameter/fintrust/dev/scoring/db_host",
        "arn:aws:ssm:af-south-1:966467878406:parameter/fintrust/dev/scoring/db_name",
        "arn:aws:ssm:af-south-1:966467878406:parameter/fintrust/dev/scoring/db_user",
        "arn:aws:ssm:af-south-1:966467878406:parameter/fintrust/dev/report/db_host",
        "arn:aws:ssm:af-south-1:966467878406:parameter/fintrust/dev/report/db_name",
        "arn:aws:ssm:af-south-1:966467878406:parameter/fintrust/dev/report/db_user",
        "arn:aws:ssm:af-south-1:966467878406:parameter/fintrust/dev/api/db_host",
        "arn:aws:ssm:af-south-1:966467878406:parameter/fintrust/dev/api/db_name",
        "arn:aws:ssm:af-south-1:966467878406:parameter/fintrust/dev/api/db_user"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        }
      }
    }
  ]
}
