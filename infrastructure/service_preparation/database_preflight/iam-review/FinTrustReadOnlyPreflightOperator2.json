{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UseOwnedEndpointSg",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpcEndpoint"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:ResourceTag/Project": "FinTrust",
          "aws:ResourceTag/Environment": "dev",
          "aws:ResourceTag/Purpose": "temporary-migration"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-17T14:31:00Z"
        }
      }
    },
    {
      "Sid": "CreateSecretEndpoint",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpcEndpoint"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:vpc-endpoint/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:RequestTag/Project": "FinTrust",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Purpose": "temporary-migration",
          "ec2:VpceServiceName": "com.amazonaws.af-south-1.secretsmanager"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-17T14:31:00Z"
        }
      }
    },
    {
      "Sid": "OwnTemporarySgRules",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:DeleteSecurityGroup"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:ResourceTag/Project": "FinTrust",
          "aws:ResourceTag/Environment": "dev",
          "aws:ResourceTag/Purpose": "temporary-migration"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-17T14:31:00Z"
        }
      }
    },
    {
      "Sid": "RemoveEndpoint",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteVpcEndpoints"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:vpc-endpoint/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:ResourceTag/Project": "FinTrust",
          "aws:ResourceTag/Environment": "dev",
          "aws:ResourceTag/Purpose": "temporary-migration"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-17T14:31:00Z"
        }
      }
    },
    {
      "Sid": "CreationTags",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:af-south-1:966467878406:security-group/*",
        "arn:aws:ec2:af-south-1:966467878406:vpc-endpoint/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:RequestTag/Project": "FinTrust",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Purpose": "temporary-migration"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        },
        "StringLike": {
          "ec2:CreateAction": [
            "CreateSecurityGroup",
            "CreateVpcEndpoint"
          ]
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-17T14:31:00Z"
        }
      }
    },
    {
      "Sid": "PassOnlyRunner",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::966467878406:role/fintrust-migration-dev",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "iam:PassedToService": "lambda.amazonaws.com"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-17T14:31:00Z"
        }
      }
    },
    {
      "Sid": "CreateFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:TagResource"
      ],
      "Resource": "arn:aws:lambda:af-south-1:966467878406:function:fintrust-migration-dev",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:RequestTag/Project": "FinTrust",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Purpose": "temporary-migration"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-17T14:31:00Z"
        }
      }
    },
    {
      "Sid": "ManageFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:PutFunctionConcurrency",
        "lambda:DeleteFunction",
        "lambda:PublishVersion",
        "lambda:DeleteFunctionConcurrency"
      ],
      "Resource": [
        "arn:aws:lambda:af-south-1:966467878406:function:fintrust-migration-dev",
        "arn:aws:lambda:af-south-1:966467878406:function:fintrust-migration-dev:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-17T14:31:00Z"
        }
      }
    },
    {
      "Sid": "ReadFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetFunctionConcurrency",
        "lambda:ListVersionsByFunction",
        "lambda:ListTags"
      ],
      "Resource": [
        "arn:aws:lambda:af-south-1:966467878406:function:fintrust-migration-dev",
        "arn:aws:lambda:af-south-1:966467878406:function:fintrust-migration-dev:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-17T14:31:00Z"
        }
      }
    },
    {
      "Sid": "CreateLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup"
      ],
      "Resource": "arn:aws:logs:af-south-1:966467878406:log-group:/aws/lambda/fintrust-migration-dev:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:RequestTag/Project": "FinTrust",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Purpose": "temporary-migration"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-17T14:31:00Z"
        }
      }
    },
    {
      "Sid": "LegacyTagLogs",
      "Effect": "Allow",
      "Action": [
        "logs:TagLogGroup"
      ],
      "Resource": "arn:aws:logs:af-south-1:966467878406:log-group:/aws/lambda/fintrust-migration-dev:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-17T14:31:00Z"
        }
      }
    }
  ]
}
