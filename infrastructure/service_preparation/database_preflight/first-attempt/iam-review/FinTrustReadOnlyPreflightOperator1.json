{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Validate",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ValidateTemplate",
        "cloudformation:GetTemplateSummary"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-17T12:01:05Z"
        }
      }
    },
    {
      "Sid": "PrepareNetwork",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet"
      ],
      "Resource": "arn:aws:cloudformation:af-south-1:966467878406:stack/fintrust-migration-network-dev/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:RequestTag/Project": "FinTrust",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Purpose": "temporary-migration"
        },
        "ForAllValues:StringEquals": {
          "cloudformation:ResourceTypes": [
            "AWS::EC2::SecurityGroup",
            "AWS::EC2::SecurityGroupIngress",
            "AWS::EC2::VPCEndpoint"
          ]
        },
        "Null": {
          "cloudformation:ResourceTypes": "false",
          "cloudformation:RoleArn": "true",
          "cloudformation:ImportResourceTypes": "true"
        },
        "StringLike": {
          "cloudformation:ChangeSetName": "fintrust-migration-network-*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-17T12:01:05Z"
        }
      }
    },
    {
      "Sid": "PrepareRunner",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet"
      ],
      "Resource": "arn:aws:cloudformation:af-south-1:966467878406:stack/fintrust-migration-runner-dev/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:RequestTag/Project": "FinTrust",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Purpose": "temporary-migration"
        },
        "ForAllValues:StringEquals": {
          "cloudformation:ResourceTypes": [
            "AWS::Lambda::Function",
            "AWS::Lambda::Version",
            "AWS::Logs::LogGroup"
          ]
        },
        "Null": {
          "cloudformation:ResourceTypes": "false",
          "cloudformation:RoleArn": "true",
          "cloudformation:ImportResourceTypes": "true"
        },
        "StringLike": {
          "cloudformation:ChangeSetName": "fintrust-migration-runner-*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-17T12:01:05Z"
        }
      }
    },
    {
      "Sid": "ReadStacks",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeChangeSet",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResource",
        "cloudformation:ListStackResources",
        "cloudformation:GetTemplate"
      ],
      "Resource": [
        "arn:aws:cloudformation:af-south-1:966467878406:stack/fintrust-migration-network-dev/*",
        "arn:aws:cloudformation:af-south-1:966467878406:stack/fintrust-migration-runner-dev/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-17T12:01:05Z"
        }
      }
    },
    {
      "Sid": "ManageReviewedSets",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet"
      ],
      "Resource": [
        "arn:aws:cloudformation:af-south-1:966467878406:stack/fintrust-migration-network-dev/*",
        "arn:aws:cloudformation:af-south-1:966467878406:stack/fintrust-migration-runner-dev/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "StringLike": {
          "cloudformation:ChangeSetName": "fintrust-migration-*"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-17T12:01:05Z"
        }
      }
    },
    {
      "Sid": "DeleteTemporaryStacks",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DeleteStack"
      ],
      "Resource": [
        "arn:aws:cloudformation:af-south-1:966467878406:stack/fintrust-migration-network-dev/*",
        "arn:aws:cloudformation:af-south-1:966467878406:stack/fintrust-migration-runner-dev/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "Null": {
          "cloudformation:RoleArn": "true"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-17T12:01:05Z"
        }
      }
    },
    {
      "Sid": "ReadNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeVpcEndpoints",
        "ec2:DescribeVpcEndpointServices",
        "ec2:GetSecurityGroupsForVpc",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeNetworkAcls",
        "ec2:DescribeRouteTables",
        "ec2:DescribeVpcAttribute",
        "ec2:DescribeAvailabilityZones"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-17T12:01:05Z"
        }
      }
    },
    {
      "Sid": "CreateTemporarySg",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:RequestTag/Project": "FinTrust",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Purpose": "temporary-migration"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-17T12:01:05Z"
        }
      }
    },
    {
      "Sid": "UseExistingVpc",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup",
        "ec2:CreateVpcEndpoint"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:vpc/vpc-0aba008bb360f5147",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-17T12:01:05Z"
        }
      }
    },
    {
      "Sid": "UseSingleSubnet",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpcEndpoint"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:subnet/subnet-0c2d87e8a83361e30",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-17T12:01:05Z"
        }
      }
    }
  ]
}
