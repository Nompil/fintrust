{
  "status": "REMOVED_AFTER_PREFLIGHT",
  "boundary_created": false,
  "role_created": false,
  "runtime_installed": false,
  "validation": {
    "findings": []
  },
  "initial_document": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "Logs",
        "Effect": "Allow",
        "Action": [
          "logs:CreateLogStream",
          "logs:PutLogEvents"
        ],
        "Resource": "arn:aws:logs:af-south-1:966467878406:log-group:/aws/lambda/fintrust-migration-dev:log-stream:*",
        "Condition": {
          "StringEquals": {
            "aws:RequestedRegion": "af-south-1"
          }
        }
      },
      {
        "Sid": "LambdaEni",
        "Effect": "Allow",
        "Action": [
          "ec2:CreateNetworkInterface",
          "ec2:DescribeNetworkInterfaces",
          "ec2:DescribeSubnets",
          "ec2:DeleteNetworkInterface",
          "ec2:AssignPrivateIpAddresses",
          "ec2:UnassignPrivateIpAddresses"
        ],
        "Resource": "*",
        "Condition": {
          "StringEquals": {
            "aws:RequestedRegion": "af-south-1"
          }
        }
      },
      {
        "Sid": "NoCodeEni",
        "Effect": "Deny",
        "Action": [
          "ec2:CreateNetworkInterface",
          "ec2:DescribeNetworkInterfaces",
          "ec2:DescribeSubnets",
          "ec2:DeleteNetworkInterface",
          "ec2:AssignPrivateIpAddresses",
          "ec2:UnassignPrivateIpAddresses"
        ],
        "Resource": "*",
        "Condition": {
          "ArnEquals": {
            "lambda:SourceFunctionArn": "arn:aws:lambda:af-south-1:966467878406:function:fintrust-migration-dev"
          }
        }
      }
    ]
  },
  "secret_access_enabled": false,
  "sql_executed": false
