{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ValidateNetworkTemplate",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ValidateTemplate",
        "cloudformation:GetTemplateSummary"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        }
      }
    },
    {
      "Sid": "PrepareNetworkChangeSet",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet"
      ],
      "Resource": "arn:aws:cloudformation:af-south-1:966467878406:stack/fintrust-network-dev/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:RequestTag/Project": "FinTrust",
          "aws:RequestTag/Environment": "dev"
        },
        "ForAllValues:StringEquals": {
          "cloudformation:ResourceTypes": [
            "AWS::EC2::RouteTable",
            "AWS::EC2::SecurityGroup",
            "AWS::EC2::SecurityGroupIngress",
            "AWS::EC2::Subnet",
            "AWS::EC2::SubnetRouteTableAssociation",
            "AWS::EC2::VPC",
            "AWS::EC2::VPCEndpoint",
            "AWS::RDS::DBSubnetGroup"
          ]
        },
        "Null": {
          "cloudformation:ResourceTypes": "false",
          "cloudformation:RoleArn": "true",
          "cloudformation:ImportResourceTypes": "true"
        },
        "StringLike": {
          "cloudformation:ChangeSetName": "fintrust-network-*"
        }
      }
    },
    {
      "Sid": "ReadSet",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeChangeSet"
      ],
      "Resource": "arn:aws:cloudformation:af-south-1:966467878406:stack/fintrust-network-dev/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        }
      }
    },
    {
      "Sid": "ManageSet",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet"
      ],
      "Resource": "arn:aws:cloudformation:af-south-1:966467878406:stack/fintrust-network-dev/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "StringLike": {
          "cloudformation:ChangeSetName": "fintrust-network-*"
        }
      }
    },
    {
      "Sid": "ReadNetworkStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:ListStackResources",
        "cloudformation:GetTemplate"
      ],
      "Resource": "arn:aws:cloudformation:af-south-1:966467878406:stack/fintrust-network-dev/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        }
      }
    },
    {
      "Sid": "RecoverOrRemoveNetworkStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DeleteStack",
        "cloudformation:ContinueUpdateRollback"
      ],
      "Resource": "arn:aws:cloudformation:af-south-1:966467878406:stack/fintrust-network-dev/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "Null": {
          "cloudformation:RoleArn": "true"
        }
      }
    }
  ]
}
