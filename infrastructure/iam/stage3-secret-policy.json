{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateRdsManagedSecret",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:TagResource"
      ],
      "Resource": "arn:aws:secretsmanager:af-south-1:966467878406:secret:rds!db-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        }
      }
    },
    {
      "Sid": "DescribeManagedEncryptionKeys",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey"
      ],
      "Resource": "arn:aws:kms:af-south-1:966467878406:key/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "ForAnyValue:StringEquals": {
          "kms:ResourceAliases": [
            "alias/aws/rds",
            "alias/aws/secretsmanager"
          ]
        }
      }
    }
  ]
}
