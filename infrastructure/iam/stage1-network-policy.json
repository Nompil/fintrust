{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRegionalNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeVpcEndpoints",
        "ec2:DescribeVpcEndpointServices",
        "ec2:DescribePrefixLists",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeTags",
        "ec2:DescribeNetworkInterfaces"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        }
      }
    },
    {
      "Sid": "ReadOwnedVpcAttributes",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcAttribute"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:vpc/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:ResourceTag/Project": "FinTrust",
          "aws:ResourceTag/Environment": "dev"
        }
      }
    },
    {
      "Sid": "CreateVpc",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:vpc/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:RequestTag/Project": "FinTrust",
          "aws:RequestTag/Environment": "dev"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "CreateSubnet",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:subnet/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:RequestTag/Project": "FinTrust",
          "aws:RequestTag/Environment": "dev"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "CreateRouteTable",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateRouteTable"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:route-table/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:RequestTag/Project": "FinTrust",
          "aws:RequestTag/Environment": "dev"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "CreateSecurityGroup",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:RequestTag/Project": "FinTrust",
          "aws:RequestTag/Environment": "dev"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "UseOwnedVpc",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:CreateVpcEndpoint"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:vpc/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:ResourceTag/Project": "FinTrust",
          "aws:ResourceTag/Environment": "dev"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "CreateServiceEndpoints",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpcEndpoint"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:vpc-endpoint/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:RequestTag/Project": "FinTrust",
          "aws:RequestTag/Environment": "dev",
          "ec2:VpceServiceName": [
            "com.amazonaws.af-south-1.s3",
            "com.amazonaws.af-south-1.dynamodb"
          ]
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "EndpointRouteTables",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpcEndpoint",
        "ec2:ModifyVpcEndpoint"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:route-table/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:ResourceTag/Project": "FinTrust",
          "aws:ResourceTag/Environment": "dev"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "TagDuringCreation",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:af-south-1:966467878406:vpc/*",
        "arn:aws:ec2:af-south-1:966467878406:subnet/*",
        "arn:aws:ec2:af-south-1:966467878406:route-table/*",
        "arn:aws:ec2:af-south-1:966467878406:security-group/*",
        "arn:aws:ec2:af-south-1:966467878406:vpc-endpoint/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:RequestTag/Project": "FinTrust",
          "aws:RequestTag/Environment": "dev",
          "ec2:CreateAction": [
            "CreateVpc",
            "CreateSubnet",
            "CreateRouteTable",
            "CreateSecurityGroup",
            "CreateVpcEndpoint"
          ]
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "VpcDnsAttributes",
      "Effect": "Allow",
      "Action": [
        "ec2:ModifyVpcAttribute"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:vpc/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:ResourceTag/Project": "FinTrust",
          "aws:ResourceTag/Environment": "dev",
          "ec2:Attribute": [
            "EnableDnsSupport",
            "EnableDnsHostnames"
          ]
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "PrivateSubnetAttribute",
      "Effect": "Allow",
      "Action": [
        "ec2:ModifySubnetAttribute"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:subnet/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:ResourceTag/Project": "FinTrust",
          "aws:ResourceTag/Environment": "dev",
          "ec2:Attribute": "mapPublicIpOnLaunch",
          "ec2:Attribute/mapPublicIpOnLaunch": "false"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "OwnedRouteAssociations",
      "Effect": "Allow",
      "Action": [
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:ReplaceRouteTableAssociation"
      ],
      "Resource": [
        "arn:aws:ec2:af-south-1:966467878406:route-table/*",
        "arn:aws:ec2:af-south-1:966467878406:subnet/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:ResourceTag/Project": "FinTrust",
          "aws:ResourceTag/Environment": "dev"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "OwnedSecurityRules",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:ResourceTag/Project": "FinTrust",
          "aws:ResourceTag/Environment": "dev"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "NoEndpointSubnetOrSecurityGroupAttachment",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateVpcEndpoint",
        "ec2:ModifyVpcEndpoint"
      ],
      "Resource": [
        "arn:aws:ec2:af-south-1:966467878406:subnet/*",
        "arn:aws:ec2:af-south-1:966467878406:security-group/*"
      ]
    },
    {
      "Sid": "OwnedNetworkCleanupAndEndpointPolicy",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteRouteTable",
        "ec2:DeleteSecurityGroup",
        "ec2:DeleteSubnet",
        "ec2:DeleteVpc",
        "ec2:DeleteVpcEndpoints",
        "ec2:ModifyVpcEndpoint"
      ],
      "Resource": [
        "arn:aws:ec2:af-south-1:966467878406:route-table/*",
        "arn:aws:ec2:af-south-1:966467878406:security-group/*",
        "arn:aws:ec2:af-south-1:966467878406:subnet/*",
        "arn:aws:ec2:af-south-1:966467878406:vpc-endpoint/*",
        "arn:aws:ec2:af-south-1:966467878406:vpc/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:ResourceTag/Project": "FinTrust",
          "aws:ResourceTag/Environment": "dev"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    }
  ]
}
