{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateNamedBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket"
      ],
      "Resource": [
        "arn:aws:s3:::fintrust-raw-966467878406-af-south-1-dev",
        "arn:aws:s3:::fintrust-quarantine-966467878406-af-south-1-dev",
        "arn:aws:s3:::fintrust-reports-966467878406-af-south-1-dev"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "s3:LocationConstraint": "af-south-1"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ConfigureNamedBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketTagging",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketVersioning",
        "s3:PutEncryptionConfiguration",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::fintrust-raw-966467878406-af-south-1-dev",
        "arn:aws:s3:::fintrust-quarantine-966467878406-af-south-1-dev",
        "arn:aws:s3:::fintrust-reports-966467878406-af-south-1-dev"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "InspectNamedBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketTagging",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetBucketPolicy",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketAcl",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::fintrust-raw-966467878406-af-south-1-dev",
        "arn:aws:s3:::fintrust-quarantine-966467878406-af-south-1-dev",
        "arn:aws:s3:::fintrust-reports-966467878406-af-south-1-dev"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        }
      }
    }
  ]
}
