digraph FinTrust {
graph [bgcolor="#ffffff",fontname="Arial",fontsize=22,pad=0.3,nodesep=0.45,ranksep=0.65]; node [shape=box,style="rounded,filled",fillcolor="#edf5f3",color="#2b6557",fontname="Arial",fontsize=17,margin="0.18,0.13"]; edge [color="#607d8b",fontname="Arial",fontsize=13,arrowsize=0.7];
rankdir=LR; label="AWS | af-south-1 | Verified foundation; application wiring pending"; labelloc=t;
subgraph cluster_private {label=""; color="#2b6557";api;score;rds;report;gate;} raw [fillcolor="#d6eee4"];quar [fillcolor="#d6eee4"];reports [fillcolor="#d6eee4"];fifo [fillcolor="#d6eee4"];dlq [fillcolor="#d6eee4"];ddb [fillcolor="#d6eee4"];rds [fillcolor="#d6eee4"];gate [fillcolor="#d6eee4"]; ingest [fillcolor="#fff0cb"]; apiG [fillcolor="#e8edf9"];api [fillcolor="#e8edf9"];score [fillcolor="#e8edf9"];alert [fillcolor="#e8edf9"];report [fillcolor="#e8edf9"];sched [fillcolor="#e8edf9"];stream [fillcolor="#e8edf9"];browser [fillcolor="#e8edf9"];guard [shape=note];
browser [label="Internal operations UI\nLocal verified; cloud\nidentity pending",shape=box];
apiG [label="API Gateway\nAuthenticated target",shape=box];
api [label="Query / workflow Lambda\nPrivate application subnets",shape=box];
raw [label="S3 input bucket\nVerified foundation",shape=box];
ingest [label="Ingest Lambda\nOutside VPC; existing\ndeployment disabled",shape=box];
fifo [label="SQS transactions FIFO\nVerified; target trigger\npending",shape=box];
dlq [label="FIFO DLQ + async failure\nqueues\nVerified; replay controlled",shape=box];
score [label="Scoring Lambda\nPrivate application subnets",shape=box];
rds [label="Private RDS PostgreSQL 16\nVerified instance; live SQL\nbootstrap pending",shape=box];
ddb [label="DynamoDB risk projection\nVerified table; Streams\nwiring pending",shape=box];
stream [label="DynamoDB Streams\nTarget mapping",shape=box];
alert [label="Alert Lambda -> SES\nOutside VPC; delivery\npending",shape=box];
quar [label="S3 quarantine bucket\nVerified; safe row evidence",shape=box];
sched [label="EventBridge monthly\nschedule\nTarget; initially disabled",shape=box];
report [label="Report Lambda\nPrivate application subnets",shape=box];
reports [label="S3 reports bucket\nVerified; CSV / JSON",shape=box];
gate [label="S3 + DynamoDB gateway\nendpoints\nVerified; no NAT",shape=box];
guard [label="Scoped IAM / KMS /\nCloudWatch\nLeast privilege; target\nruntime monitoring",shape=box];
browser -> apiG;
apiG -> api;
api -> rds;
raw -> ingest;
ingest -> fifo;
ingest -> quar;
fifo -> score;
fifo -> dlq;
score -> rds;
score -> ddb;
ddb -> stream;
stream -> alert;
sched -> report;
report -> rds;
report -> reports;
gate -> score;
gate -> api;
gate -> report;

legend [shape=note,fontsize=14,label="GREEN: Verified foundation\nBLUE: Target / pending\nGOLD: Disabled ingest\nOutline: private VPC",pos="0,10!"];
graph [overlap=false,splines=true,sep="+10"];
browser [pos="4,10!"];
apiG [pos="8,10!"];
guard [pos="12,10!"];
raw [pos="0,7.5!"];
