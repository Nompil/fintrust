// VIEW: Role-grouped use cases
digraph FinTrust {
graph [bgcolor="white",fontname="Arial",fontsize=22,pad=.3,nodesep=.65,ranksep=.7,splines=ortho]; node [shape=box,style="rounded,filled",fillcolor="#edf5f3",color="#2b6557",fontname="Arial",fontsize=17,margin=".2,.15"]; edge [color="#607d8b",fontname="Arial",fontsize=12,arrowsize=.7]; labelloc=t;
rankdir=LR;label="USE CASES | Independent role groups; no permission inheritance";
subgraph cluster_admin {label="Administrator";color="#ccded8";admin [label="Administrator"];
admin0 [label="Governance: users / roles / status",shape=ellipse];admin -> admin0;
admin1 [label="Monitoring: platform state",shape=ellipse];admin -> admin1;
admin2 [label="Reporting: scoped reads / Insights",shape=ellipse];admin -> admin2;
admin3 [label="Audit oversight",shape=ellipse];admin -> admin3;
}
subgraph cluster_analyst {label="Risk / Compliance Analyst";color="#ccded8";analyst [label="Risk / Compliance Analyst"];
analyst0 [label="Ingestion: upload / batch results",shape=ellipse];analyst -> analyst0;
analyst1 [label="Risk: investigate / resolve / escalate",shape=ellipse];analyst -> analyst1;
analyst2 [label="Quarantine: correct / reject; revalidate",shape=ellipse];analyst -> analyst2;
analyst3 [label="Reporting: assigned records / Insights",shape=ellipse];analyst -> analyst3;
}
subgraph cluster_auditor {label="Auditor";color="#ccded8";auditor [label="Auditor"];
auditor0 [label="Monitoring: scoped transactions / batches",shape=ellipse];auditor -> auditor0;
auditor1 [label="Risk: evidence / review history",shape=ellipse];auditor -> auditor1;
auditor2 [label="Reporting: reports / Insights",shape=ellipse];auditor -> auditor2;
auditor3 [label="Audit: read-only history",shape=ellipse];auditor -> auditor3;
}
subgraph cluster_maint {label="Technical Maintainer";color="#ccded8";maint [label="Technical Maintainer"];
maint0 [label="Operations: failures / controlled retry",shape=ellipse];maint -> maint0;
maint1 [label="Monitoring: alert / projection failures",shape=ellipse];maint -> maint1;
}

}
