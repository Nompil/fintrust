digraph FinTrust {
graph [bgcolor="#ffffff",fontname="Arial",fontsize=22,pad=0.3,nodesep=0.45,ranksep=0.65]; node [shape=box,style="rounded,filled",fillcolor="#edf5f3",color="#2b6557",fontname="Arial",fontsize=17,margin="0.18,0.13"]; edge [color="#607d8b",fontname="Arial",fontsize=13,arrowsize=0.7];
rankdir=TB; label="BUSINESS ACTIVITY | Validate -> protect identity -> assess -> review"; labelloc=t;

user [label="Analyst uploads CSV",shape=box];
file [label="File format valid?",shape=diamond];
reject [label="Reject file\nNo ledger work",shape=box];
hash [label="Same file hash?",shape=diamond];
old [label="View original batch\nRecord replay attempt",shape=box];
batch [label="Create batch / row lineage",shape=box];
valid [label="Row valid?",shape=diamond];
quar [label="Quarantine original\nSafe payload + reason",shape=box];
correct [label="Analyst corrects\nNew occurrence; revalidate",shape=box];
identity [label="Identity / facts check",shape=box];
duplicate [label="Same- or cross-file\nduplicate\nRecord occurrence; no new\nledger entry",shape=box];
conflict [label="Identity conflict\nQuarantine; investigate",shape=box];
queue [label="Queue unique valid rows\nFIFO by account",shape=box];
score [label="Worker validates account\nScore frozen rules",shape=box];
sql [label="Commit ledger + assessment\nReview / outbox metadata",shape=box];
level [label="Risk level?",shape=diamond];
low [label="LOW\nAccepted; no routine review",shape=box];
medium [label="MEDIUM\nOpen review",shape=box];
high [label="HIGH\nReview + alert via Streams",shape=box];
review [label="OPEN -> UNDER_REVIEW\nCLEARED / CONFIRMED_RISK /\nESCALATED",shape=box];
audit [label="Named actor + audit history",shape=box];
reads [label="Insights + reports",shape=box];
fail [label="Technical failure\nPending / failed outcome",shape=box];
retry [label="Retry; exhausted retries to\nDLQ",shape=box];
ops [label="Maintainer investigates\nControlled redrive / outbox\nretry",shape=box];
user -> file;
file -> reject [label="No"];
file -> hash [label="Yes"];
hash -> old [label="Yes"];
hash -> batch [label="No"];
batch -> valid;
valid -> quar [label="No"];
quar -> correct;
correct -> valid;
valid -> identity [label="Yes"];
identity -> duplicate [label="Replay"];
identity -> conflict [label="Conflict"];
conflict -> quar;
identity -> queue [label="Unique"];
queue -> score;
score -> sql;
sql -> level;
level -> low;
level -> medium;
level -> high;
medium -> review;
high -> review;
review -> audit;
audit -> reads;
sql -> reads;
score -> fail [style=dashed,color="#a96a3a"];
sql -> fail [style=dashed,color="#a96a3a"];
fail -> retry;
retry -> ops;
ops -> queue;

graph [overlap=false,splines=true,sep="+10"];
user [pos="0.0,0.0!"];
file [pos="4.3,0.0!"];
hash [pos="8.6,0.0!"];
old [pos="4.3,-7.5!"];
reject [pos="0.0,-7.5!"];
batch [pos="12.899999999999999,0.0!"];
valid [pos="17.2,0.0!"];
quar [pos="17.2,-7.5!"];
correct [pos="12.899999999999999,-10.0!"];
conflict [pos="12.899999999999999,-7.5!"];
identity [pos="17.2,-2.5!"];
duplicate [pos="8.6,-7.5!"];
queue [pos="12.899999999999999,-2.5!"];
score [pos="8.6,-2.5!"];
sql [pos="4.3,-2.5!"];
level [pos="0.0,-2.5!"];
low [pos="0.0,-5.0!"];
medium [pos="4.3,-5.0!"];
high [pos="8.6,-5.0!"];
review [pos="12.899999999999999,-5.0!"];
fail [pos="0.0,-10.0!"];
retry [pos="4.3,-10.0!"];
ops [pos="8.6,-10.0!"];
audit [pos="17.2,-5.0!"];
reads [pos="17.2,-10.0!"];
}
