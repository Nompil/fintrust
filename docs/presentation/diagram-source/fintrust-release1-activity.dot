// VIEW: Admission and reconciliation
digraph FinTrust {
graph [bgcolor="white",fontname="Arial",fontsize=22,pad=.3,nodesep=.65,ranksep=.7,splines=ortho]; node [shape=box,style="rounded,filled",fillcolor="#edf5f3",color="#2b6557",fontname="Arial",fontsize=17,margin=".2,.15"]; edge [color="#607d8b",fontname="Arial",fontsize=12,arrowsize=.7]; labelloc=t;
rankdir=TB;label="ACTIVITY | Admit -> validate -> protect identity -> assess -> reconcile";

start [label="Start",shape=oval]; upload [label="Analyst uploads CSV"]; file [label="File valid?",shape=diamond];
reject [label="Invalid file\nReject; safe receipt\nEnd upload",fillcolor="#fff0cb"];
hash [label="Exact file replay?",shape=diamond]; replay [label="Replay\nView original batch\nAudit attempt; no reprocessing"];
batch [label="Admit batch + row lineage"]; row [label="Row valid?",shape=diamond]; quar [label="Invalid row\nQuarantine + reason\nCount reconciled outcome",fillcolor="#fff0cb"];
identity [label="Identity / facts?",shape=diamond]; dup [label="Same facts\nRecord duplicate occurrence\nNo new ledger entry"]; conflict [label="Changed facts\nQuarantine identity conflict\nInvestigate",fillcolor="#fff0cb"];
score [label="Unique valid row\nFIFO by account; score"]; commit [label="Commit ledger + assessment\nPersist review / outbox intent"];
risk [label="Risk level?",shape=diamond]; low [label="LOW\nStore; no routine review"]; medium [label="MEDIUM\nOpen review"]; high [label="HIGH\nReview + alert path"];
reconcile [label="Reconcile every received row\nAccepted / quarantine / duplicate\nPending or technical failure visible"];
end [label="End / visible batch outcome",shape=oval];
start -> upload -> file; file -> reject; file -> hash; hash -> replay; hash -> batch;
batch -> row; row -> quar; row -> identity; identity -> dup; identity -> conflict; identity -> score;
score -> commit -> risk; risk -> low; risk -> medium; risk -> high;
low -> reconcile; medium -> reconcile; high -> reconcile; reconcile -> end;

}

// VIEW: Correction recovery and review
digraph FinTrust {
graph [bgcolor="white",fontname="Arial",fontsize=22,pad=.3,nodesep=.65,ranksep=.7,splines=ortho]; node [shape=box,style="rounded,filled",fillcolor="#edf5f3",color="#2b6557",fontname="Arial",fontsize=17,margin=".2,.15"]; edge [color="#607d8b",fontname="Arial",fontsize=12,arrowsize=.7]; labelloc=t;
rankdir=LR;label="RECOVERY | Technical retry and compliance decisions are separate";

subgraph cluster_q {label="BUSINESS CORRECTION";color="#ccded8";
q [label="Quarantine original + reason"]; c [label="Analyst corrects\nNew version / occurrence"]; v [label="Worker revalidates\nIdentity / duplicate checks again"]; ret [label="Return to admission\nOriginal remains preserved"]; q -> c -> v -> ret;}
subgraph cluster_t {label="TECHNICAL RECOVERY";color="#ccded8";
f [label="Technical failure\nVisible pending / failed outcome"]; retry [label="Bounded retry"]; dlq [label="Exhausted retries\nDead-letter queue"]; maint [label="Maintainer controlled redrive\nIdempotent ledger / outbox retry"]; f -> retry -> dlq -> maint;}
subgraph cluster_r {label="COMPLIANCE REVIEW";color="#ccded8";
open [label="OPEN"]; under [label="UNDER_REVIEW"]; decision [label="CLEARED / CONFIRMED_RISK\nESCALATED"]; audit [label="Named actor + immutable history\nReports / Insights / audit"]; open -> under -> decision -> audit;}

}
