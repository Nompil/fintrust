{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Validate",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ValidateTemplate",
        "cloudformation:GetTemplateSummary"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        }
      }
    },
    {
      "Sid": "PrepareNetwork",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet"
      ],
      "Resource": "arn:aws:cloudformation:af-south-1:966467878406:stack/fintrust-migration-network-dev/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:RequestTag/Project": "FinTrust",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Purpose": "temporary-migration"
        },
        "ForAllValues:StringEquals": {
          "cloudformation:ResourceTypes": [
            "AWS::EC2::SecurityGroup",
            "AWS::EC2::SecurityGroupIngress",
            "AWS::EC2::VPCEndpoint"
          ]
        },
        "Null": {
          "cloudformation:ResourceTypes": "false",
          "cloudformation:RoleArn": "true",
          "cloudformation:ImportResourceTypes": "true"
        },
        "StringLike": {
          "cloudformation:ChangeSetName": "fintrust-migration-network-*"
        }
      }
    },
    {
      "Sid": "PrepareRunner",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet"
      ],
      "Resource": "arn:aws:cloudformation:af-south-1:966467878406:stack/fintrust-migration-runner-dev/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:RequestTag/Project": "FinTrust",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Purpose": "temporary-migration"
        },
        "ForAllValues:StringEquals": {
          "cloudformation:ResourceTypes": [
            "AWS::Lambda::Function",
            "AWS::Lambda::Version",
            "AWS::Logs::LogGroup"
          ]
        },
        "Null": {
          "cloudformation:ResourceTypes": "false",
          "cloudformation:RoleArn": "true",
          "cloudformation:ImportResourceTypes": "true"
        },
        "StringLike": {
          "cloudformation:ChangeSetName": "fintrust-migration-runner-*"
        }
      }
    },
    {
      "Sid": "ReadStacks",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeChangeSet",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResource",
        "cloudformation:ListStackResources",
        "cloudformation:GetTemplate"
      ],
      "Resource": [
        "arn:aws:cloudformation:af-south-1:966467878406:stack/fintrust-migration-network-dev/*",
        "arn:aws:cloudformation:af-south-1:966467878406:stack/fintrust-migration-runner-dev/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        }
      }
    },
    {
      "Sid": "ManageReviewedSets",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet"
      ],
      "Resource": [
        "arn:aws:cloudformation:af-south-1:966467878406:stack/fintrust-migration-network-dev/*",
        "arn:aws:cloudformation:af-south-1:966467878406:stack/fintrust-migration-runner-dev/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "StringLike": {
          "cloudformation:ChangeSetName": "fintrust-migration-*"
        }
      }
    },
    {
      "Sid": "DeleteTemporaryStacks",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DeleteStack"
      ],
      "Resource": [
        "arn:aws:cloudformation:af-south-1:966467878406:stack/fintrust-migration-network-dev/*",
        "arn:aws:cloudformation:af-south-1:966467878406:stack/fintrust-migration-runner-dev/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "Null": {
          "cloudformation:RoleArn": "true"
        }
      }
    },
    {
      "Sid": "ReadNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeVpcEndpoints",
        "ec2:DescribeVpcEndpointServices",
        "ec2:GetSecurityGroupsForVpc"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        }
      }
    },
    {
      "Sid": "CreateTemporarySg",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:RequestTag/Project": "FinTrust",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Purpose": "temporary-migration"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "UseExistingVpc",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup",
        "ec2:CreateVpcEndpoint"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:vpc/vpc-0aba008bb360f5147",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "UseSingleSubnet",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpcEndpoint"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:subnet/subnet-0c2d87e8a83361e30",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "UseOwnedEndpointSg",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpcEndpoint"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:ResourceTag/Project": "FinTrust",
          "aws:ResourceTag/Environment": "dev",
          "aws:ResourceTag/Purpose": "temporary-migration"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "CreateSecretEndpoint",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpcEndpoint"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:vpc-endpoint/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:RequestTag/Project": "FinTrust",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Purpose": "temporary-migration",
          "ec2:VpceServiceName": "com.amazonaws.af-south-1.secretsmanager",
          "ec2:VpcEndpointType": "Interface"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "OwnTemporarySgRules",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:DeleteSecurityGroup"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:ResourceTag/Project": "FinTrust",
          "aws:ResourceTag/Environment": "dev",
          "aws:ResourceTag/Purpose": "temporary-migration"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "RemoveEndpoint",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteVpcEndpoints"
      ],
      "Resource": "arn:aws:ec2:af-south-1:966467878406:vpc-endpoint/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:ResourceTag/Project": "FinTrust",
          "aws:ResourceTag/Environment": "dev",
          "aws:ResourceTag/Purpose": "temporary-migration"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "CreationTags",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:af-south-1:966467878406:security-group/*",
        "arn:aws:ec2:af-south-1:966467878406:vpc-endpoint/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:RequestTag/Project": "FinTrust",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Purpose": "temporary-migration"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        },
        "StringLike": {
          "ec2:CreateAction": [
            "CreateSecurityGroup",
            "CreateVpcEndpoint"
          ]
        }
      }
    },
    {
      "Sid": "PassOnlyRunner",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::966467878406:role/fintrust-migration-dev",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "iam:PassedToService": "lambda.amazonaws.com"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "CreateFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:TagResource"
      ],
      "Resource": "arn:aws:lambda:af-south-1:966467878406:function:fintrust-migration-dev",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:RequestTag/Project": "FinTrust",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Purpose": "temporary-migration"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ManageFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:PutFunctionConcurrency",
        "lambda:DeleteFunction",
        "lambda:PublishVersion"
      ],
      "Resource": [
        "arn:aws:lambda:af-south-1:966467878406:function:fintrust-migration-dev",
        "arn:aws:lambda:af-south-1:966467878406:function:fintrust-migration-dev:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ReadFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetFunctionConcurrency",
        "lambda:ListVersionsByFunction",
        "lambda:ListTags"
      ],
      "Resource": [
        "arn:aws:lambda:af-south-1:966467878406:function:fintrust-migration-dev",
        "arn:aws:lambda:af-south-1:966467878406:function:fintrust-migration-dev:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        }
      }
    },
    {
      "Sid": "CreateLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:TagLogGroup"
      ],
      "Resource": "arn:aws:logs:af-south-1:966467878406:log-group:/aws/lambda/fintrust-migration-dev:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:RequestTag/Project": "FinTrust",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Purpose": "temporary-migration"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "TagLogs",
      "Effect": "Allow",
      "Action": [
        "logs:TagResource"
      ],
      "Resource": "arn:aws:logs:af-south-1:966467878406:log-group:/aws/lambda/fintrust-migration-dev",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1",
          "aws:RequestTag/Project": "FinTrust",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Purpose": "temporary-migration"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "Retention",
      "Effect": "Allow",
      "Action": [
        "logs:PutRetentionPolicy"
      ],
      "Resource": "arn:aws:logs:af-south-1:966467878406:log-group:/aws/lambda/fintrust-migration-dev:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ReadLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        }
      }
    },
    {
      "Sid": "ReadLogTags",
      "Effect": "Allow",
      "Action": [
        "logs:ListTagsForResource"
      ],
      "Resource": "arn:aws:logs:af-south-1:966467878406:log-group:/aws/lambda/fintrust-migration-dev",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "af-south-1"
        }
      }
    }
  ]
}
